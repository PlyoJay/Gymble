<UserControl x:Class="Gymble.Views.Controls.DetailMemberInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Gymble.Views.Controls"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:sys="clr-namespace:System;assembly=netstandard"
             mc:Ignorable="d" 
             d:DesignHeight="790" d:DesignWidth="484"
             x:Name="root">
    <Border BorderThickness="1" BorderBrush="{StaticResource DefaultBorderBrushColor}"
            CornerRadius="8">
        <StackPanel Margin="20">
            <!--회원 정보-->
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="{Binding ElementName=root, Path=Member.Name}" 
                               Style="{StaticResource TitleTextBlockStyle}"/>
                    <ContentControl Template="{StaticResource StatusControlTemplate}" 
                                    Width="80" Height="25" Margin="20 0"
                                    Content="{Binding ElementName=root, Path=Member.Status,
                                                      Converter={StaticResource EnumToBadgeConverter}}"
                                    ContentTemplate="{x:Null}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="X" Style="{StaticResource WIndowChromeButtonStyle}"
                            Foreground="Black" FontSize="18" FontWeight="Bold"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseInfoViewCommand}"/>
                </StackPanel>
            </DockPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 10">
                    <TextBlock Text="{Binding ElementName=root, Path=Member.Gender,
                        Converter={StaticResource GenderToKoreanConverter}}" 
                               Style="{StaticResource InfoTextBlockStyle}"/>
                    <TextBlock Text=" / " Style="{StaticResource InfoTextBlockStyle}"/>
                    <TextBlock Text="{Binding ElementName=root, Path=Member.PhoneNumber,
                        Converter={StaticResource PhoneNumberConverter}}" 
                               Style="{StaticResource InfoTextBlockStyle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="이용권 등록" 
                            Command="{Binding PurchaseProductCommand}"
                            Style="{StaticResource BaseButtonStyle}"
                            Width="220"/>
                    <Button Content="수정"
                            Command="{Binding EditCommand}"
                            Style="{StaticResource BorderedButtonStyle}"
                            Width="100" Margin="10 0"/>
                    <Button Content="삭제" 
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource BorderedButtonStyle}"
                            Width="100" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
            
            <Separator Margin="0 20"
                       BorderThickness="1" 
                       BorderBrush="{StaticResource SeperatorBorderBrushColor}"/>

            <StackPanel>
                <TextBlock Text="현재 이용권" Style="{StaticResource TitleTextBlockStyle}"/>
                <ContentControl Template="{StaticResource DefaultCardTemplate}"
                                Margin="0 10"
                                MinHeight="150">
                    <Grid Margin="15">
                        <TextBlock Text="{Binding MembershipErrorMessage}"
                                   Foreground="#D32F2F"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="이용중인 이용권이 없습니다.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NoDataTextBlockStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentMemberships.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMembershipLoading}" Value="True">
                                            <Setter Property="Text" Value="이용권을 불러오는 중입니다."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding CurrentMemberships}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentMemberships.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0 0 0 12">
                                        <TextBlock Text="{Binding ProductName}"
                                                   FontSize="18"
                                                   Style="{StaticResource ContentDataTextBlockStyle}"/>
                                        <TextBlock Text="{Binding PeriodText}"
                                                   Style="{StaticResource ContentDataTextBlockStyle}"
                                                   Margin="0 8 0 4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Template="{StaticResource StatusControlTemplate}"
                                                            Width="80" Height="28"
                                                            Background="#2E7D32"
                                                            Foreground="White"
                                                            Content="{Binding StatusText}"
                                                            HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding UsageText}"
                                                       Margin="10 4 0 0"
                                                       Style="{StaticResource ContentDataTextBlockStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ContentControl>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="메모" Style="{StaticResource TitleTextBlockStyle}"/>
                <ContentControl Template="{StaticResource DefaultCardTemplate}"
                                Margin="0 10" MinHeight="50"
                                VerticalContentAlignment="Center">
                    <Grid Margin="15 0">
                        <TextBlock Text="{Binding ElementName=root, Path=Member.Memo}" 
                                   MaxWidth="300"
                                   Style="{StaticResource ContentDataTextBlockStyle}"
                                   HorizontalAlignment="Left"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"/>
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource ReadMoreButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="더보기"
                                           VerticalAlignment="Center"
                                           Margin="0 0 5 0"/>
                                <md:PackIcon Kind="ChevronRight"
                                             Width="25" Height="25"
                                             VerticalAlignment="Center"
                                             Foreground="Black"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </ContentControl>
            </StackPanel>
            
            <Separator Margin="0 10 0 20"
                       BorderThickness="1" 
                       BorderBrush="{StaticResource SeperatorBorderBrushColor}"/>

            <TabControl Style="{StaticResource GymbleTabControlStyle}" Height="260"
                        AlternationCount="1000000">
                <TabItem Header="이용권/결제 이력"
                         Style="{StaticResource GymbleTabItemStyle}">
                    <Grid Margin="15">
                        <TextBlock Text="이력이 없습니다.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NoDataTextBlockStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MembershipHistories.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMembershipLoading}" Value="True">
                                            <Setter Property="Text" Value="이력을 불러오는 중입니다."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding MembershipHistories}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MembershipHistories.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0 0 0 10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProductName}"
                                                           Style="{StaticResource ContentDataTextBlockStyle}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding PeriodText}"
                                                           Foreground="#606060"
                                                           Margin="0 4 0 0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding UsageText}"
                                                           Foreground="#606060"
                                                           HorizontalAlignment="Right"
                                                           Margin="0 4 0 0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="출석 기록"
                         Style="{StaticResource GymbleTabItemStyle}">
                    <Grid>
                        <TextBlock Text="출석 기록이 없습니다."
                                   Style="{StaticResource NoDataTextBlockStyle}"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </StackPanel>
    </Border>
</UserControl>
